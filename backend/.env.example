# Server
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8080

# OpenAI (optional - fallback to local sentiment if not set)
OPENAI_API_KEY=

# Email alerts (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=event-manager@example.com

# SMS alerts (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_TO=+1234567890

# Slack notifications (Webhook URL)
SLACK_WEBHOOK_URL=

# Alert channels to use (comma-separated: email, sms, slack)
ALERT_CHANNELS=email,sms,slack
# Minimum severity to fire alerts: critical | high | medium | low
ALERT_MIN_SEVERITY=low
# Thresholds (optional; can also be set via API)
ALERT_NEGATIVE_MINUTES=30
ALERT_NEGATIVE_COUNT=3
ALERT_RATING_BELOW=3

# Database (SQLite path; default: ./data/feedback.db)
DB_PATH=./data/feedback.db
